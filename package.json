{
  "name": "magic-card-universe",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "data:fetch": "node tools/fetch-bulk.ts",
    "data:build": "node --max-old-space-size=6144 tools/build-universe.ts",
    "test:interaction": "node tools/test-interaction.mjs",
    "og": "node tools/screenshot.mjs --out public/og.jpg --width 1200 --height 630 --quality 90 --settle 7000 --eval-file tools/og/compose.js"
  },
  "dependencies": {
    "postprocessing": "^6.37.8",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "@types/three": "^0.180.0",
    "puppeteer-core": "^25.10.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vite-plugin-glsl": "^1.3.1"
  }
}
